{
  "expo": {
    "name": "Pokedex Mobile",
    "slug": "pokedex-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-asset"
    ],
    "ios": {
      "bundleIdentifier": "com.anonymous.pokedex-mobile"
    },
    "android": {
      "package": "tsunRise.pkg"
    }
  }
}
